# MadridMove – geheime Zugangsdaten (Vorlage)
# 1. Diese Datei kopieren und die Kopie "secrets.env" nennen (gleicher Ordner: python/)
# 2. Werte eintragen (ohne Anführungszeichen, ohne Leerzeichen um das =)
# 3. secrets.env NIE committen – sie steht in .gitignore
#
# EMT MobilityLabs: Konto von https://mobilitylabs.emtmadrid.es
EMT_EMAIL=
EMT_PASSWORD=
#
# Alternativ statt E-Mail/Passwort: X-ClientId und passKey einer dort angelegten App
# EMT_CLIENT_ID=
# EMT_PASSKEY=
