# MadridMove – secret credentials (template)
# 1. Copy this file and name the copy "secrets.env" (same folder: python/)
# 2. Fill in the values (no quotes, no spaces around the =)
# 3. NEVER commit secrets.env – it is listed in .gitignore
#
# EMT MobilityLabs: account from https://mobilitylabs.emtmadrid.es
EMT_EMAIL=
EMT_PASSWORD=
#
# Alternatively, instead of e-mail/password: X-ClientId and passKey of an app created there
# EMT_CLIENT_ID=
# EMT_PASSKEY=
