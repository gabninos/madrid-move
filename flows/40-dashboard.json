    "z": "cf931b46039477f7",
    "name": "Simulationsstatus",
    "func": "// .../sim/state (retained) -> Textzeile auf der Seite \"System & Demo\"\nconst s = msg.payload;\nif (!s || typeof s !== 'object' || !s.active) return { payload: 'Keine Simulation aktiv: es laufen echte Daten.' };\nconst since = new Date(s.startedAt).toLocaleTimeString('de-DE', { timeZone: 'Europe/Madrid', hour: '2-digit', minute: '2-digit' });\nreturn { payload: '▶ ' + s.label + ' (seit ' + since + ')' + (s.phase ? ' · ' + s.phase : '') +\n    (s.stations ? ' · ' + s.stations + ' Stationen simuliert' : '') };\n",
    "outputs": 1,
