    "z": "cf931b46039477f7",
    "name": "Stationsliste",
    "func": "// .../static/stations (retained) -> Auswahllisten Start- und Zielstation.\n// Die Listen sind \"Comboboxen\": tippen filtert, z. B. \"sol\" oder die Stationsnummer.\nconst list = Array.isArray(msg.payload) ? msg.payload : [];\nflow.set('stations', list);\nconst options = list.map(s => ({ label: s.name + ' (' + s.id + ')', value: s.id }));\nnode.status({ fill: 'green', shape: 'dot', text: list.length + ' Stationen' });\nreturn { ui_update: { options: options.length ? options : [{ label: '(lädt …)', value: '' }] } };\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
