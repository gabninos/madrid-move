  {
    "id": "7a24b4f24c3b3da1",
    "type": "function",
    "name": "Karten bauen",
    "func": "// .../reco/+/+ -> Daten für die Routenkarten (eine Karte pro Route)\nconst cfg = global.get('cfg');\nlet recos = flow.get('recos');\nif (!recos || recos.__prefix !== cfg.prefix) recos = { __prefix: cfg.prefix };\nconst key = msg.topic.split('/').slice(-2).join('/');\nconst empty = msg.payload === '' || msg.payload == null ||\n    (Buffer.isBuffer(msg.payload) && msg.payload.length === 0);\nif (empty || typeof msg.payload !== 'object') delete recos[key];\nelse recos[key] = msg.payload;\nflow.set('recos', recos);\nconst routes = Object.keys(recos).filter(k => k !== '__prefix').sort().map(k => {\n    const r = recos[k];\n    return {\n        key: k, user: r.user, name: r.name, from: r.from, to: r.to,\n        status: r.status, headline: r.headline,\n        problems: r.problems || [], hints: r.hints || [], notes: r.notes || [],\n        alternatives: r.alternatives || [], bike: r.bike || {}, weather: r.weather,\n        settings: r.settings, departureText: r.departure ? r.departure.text : null,\n        nextDeparture: r.nextDeparture, nextDepartureText: r.nextDepartureText,\n        windowMin: cfg.reco.windowMin\n    };\n});\nreturn { payload: { routes: routes } };\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "ae89ea10c631b485"
      ]
    ],
    "x": 330,
    "y": 80,
    "z": "cf931b46039477f7"
  },
  {
    "id": "ae89ea10c631b485",
    "type": "ui-template",
    "name": "Routenkarten",
    "group": "b3714cda0f816020",
    "page": "",
    "ui": "",
    "order": 1,
    "width": "12",
    "height": "0",
    "head": "",
    "format": "<template>\n    <div class=\"mm\">\n        <div v-if=\"!routes.length\" class=\"mm-empty\">\n            Noch keine Routen. Lege unter „Routen &amp; Einstellungen“ eine an, mit dem Python-Client\n            oder unter „System &amp; Demo“ mit „Demo-Routen anlegen“.\n        </div>\n        <div class=\"mm-grid\">\n            <div v-for=\"r in routes\" :key=\"r.key\" class=\"mm-rc\" :class=\"'mm-' + r.status\">\n                <div class=\"mm-head\">\n                    <div>\n                        <div class=\"mm-name\">{{ r.name }}</div>\n                        <div class=\"mm-sub\">{{ r.user }} · 🚲 {{ r.from }} → {{ r.to }}</div>\n                    </div>\n                    <div class=\"mm-badges\">\n                        <span v-if=\"active(r)\" class=\"mm-badge mm-badge-on\">aktiv</span>\n                        <span v-if=\"r.weather && r.weather.demo\" class=\"mm-badge mm-badge-demo\">Simulation</span>\n                    </div>\n                </div>\n\n                <div class=\"mm-status\">\n                    <span class=\"mm-headline\">{{ r.headline }}</span>\n                    <span v-if=\"r.bike.min\" class=\"mm-min\">{{ r.bike.min }} min</span>\n                </div>\n\n                <ul v-if=\"r.problems.length\" class=\"mm-list mm-problems\">\n                    <li v-for=\"(p, i) in r.problems\" :key=\"'p' + i\">{{ p }}</li>\n                </ul>\n                <ul v-if=\"r.hints.length\" class=\"mm-list mm-hints\">\n                    <li v-for=\"(h, i) in r.hints\" :key=\"'h' + i\">{{ h }}</li>\n                </ul>\n                <div v-if=\"r.status === 'warn'\" class=\"mm-alts\">\n                    Alternativen:\n                    <span v-for=\"(a, i) in r.alternatives\" :key=\"a.mode\">{{ i ? ' · ' : ' ' }}{{ a.mode === 'transit' ? '🚌' : '🚶' }} {{ a.label }} {{ a.min }} min</span>\n                </div>\n\n                <div class=\"mm-facts\">\n                    <div v-if=\"r.bike.bikes !== null && r.bike.bikes !== undefined\">\n                        🚲 {{ r.bike.bikes }} {{ r.bike.bikes === 1 ? 'Rad' : 'Räder' }} an {{ r.from }}\n                    </div>\n                    <div v-if=\"r.weather\">🌦 {{ r.weather.text }} <span class=\"mm-dim\">({{ r.weather.source === 'Vorhersage' ? 'Vorhersage ' + r.weather.from + '–' + r.weather.to : 'aktuelles Wetter, Vorhersage reicht noch nicht bis zur Abfahrt' }})</span></div>\n                    <div v-for=\"(n, i) in r.notes\" :key=\"'n' + i\" class=\"mm-dim\">ℹ {{ n }}</div>\n                </div>\n\n                <div class=\"mm-foot\">\n                    <span>🕒 {{ r.departureText || 'keine Abfahrtszeit' }} · {{ countdown(r) }}</span>\n                    <span v-if=\"r.settings\" class=\"mm-dim\">Grenzen: {{ settingsText(r.settings) }}</span>\n                </div>\n            </div>\n        </div>\n    </div>\n</template>\n\n<script>\nexport default {\n    data () {\n        return { now: Date.now(), timer: null }\n    },\n    computed: {\n        routes () {\n            return (this.msg && this.msg.payload && this.msg.payload.routes) || []\n        }\n    },\n    methods: {\n        minutesLeft (r) {\n            return r.nextDeparture ? Math.round((Date.parse(r.nextDeparture) - this.now) / 60000) : null\n        },\n        active (r) {\n            const m = this.minutesLeft(r)\n            return m !== null && m >= 0 && m <= (r.windowMin || 30)\n        },\n        countdown (r) {\n            const m = this.minutesLeft(r)\n            if (m === null) return 'keine Fahrt in den nächsten 7 Tagen'\n            if (m <= 0) return 'Abfahrt jetzt'\n            if (m < 60) return 'Abfahrt in ' + m + ' min'\n            return 'nächste: ' + r.nextDepartureText\n        },\n        settingsText (s) {\n            const rain = { kein: 'kein Regen', leicht: 'leichter Regen ok', egal: 'Regen egal' }[s.rain] || s.rain\n            return rain + ', Wind bis ' + s.windMax + ' km/h, ' + s.tempMin + '–' + s.tempMax + ' °C'\n        }\n    },\n    mounted () {\n        // Countdown selbst weiterzählen (der Status kommt nur bei Änderungen neu)\n        this.timer = setInterval(() => { this.now = Date.now() }, 15000)\n    },\n    unmounted () {\n        clearInterval(this.timer)\n    }\n}\n</script>\n\n<style>\n.mm { width: 100%; }\n.mm-empty { color: #6b7280; padding: 8px 2px; }\n.mm-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 14px; }\n.mm-rc { border: 1px solid #dde1e4; border-left: 7px solid #9ca3af; border-radius: 10px; padding: 14px 16px; background: #fff; display: flex; flex-direction: column; gap: 10px; }\n.mm-ok { border-left-color: #1f7a4d; }\n.mm-warn { border-left-color: #c2410c; }\n.mm-unbekannt { border-left-color: #9ca3af; }\n.mm-head { display: flex; justify-content: space-between; gap: 8px; }\n.mm-name { font-weight: 700; font-size: 17px; color: #111827; }\n.mm-sub { font-size: 13px; color: #6b7280; }\n.mm-badges { display: flex; gap: 4px; align-items: flex-start; flex-wrap: wrap; justify-content: flex-end; }\n.mm-badge { font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 10px; white-space: nowrap; }\n.mm-badge-on { background: #1f7a4d; color: #fff; }\n.mm-badge-demo { background: #e0e7ff; color: #3730a3; }\n.mm-status { display: flex; align-items: baseline; gap: 10px; }\n.mm-headline { font-size: 22px; font-weight: 700; }\n.mm-ok .mm-headline { color: #1f7a4d; }\n.mm-warn .mm-headline { color: #c2410c; }\n.mm-unbekannt .mm-headline { color: #6b7280; }\n.mm-min { margin-left: auto; font-size: 20px; font-weight: 700; color: #111827; }\n.mm-list { margin: 0; padding-left: 18px; font-size: 14px; }\n.mm-problems { color: #9a3412; }\n.mm-hints { color: #6b4e00; }\n.mm-alts { font-size: 14px; background: #fff4ec; color: #7c2d12; border-radius: 6px; padding: 6px 10px; }\n.mm-facts { font-size: 13.5px; color: #374151; display: flex; flex-direction: column; gap: 3px; }\n.mm-dim { color: #9ca3af; }\n.mm-foot { font-size: 13px; color: #374151; border-top: 1px solid #eef0f2; padding-top: 8px; display: flex; flex-direction: column; gap: 2px; }\n</style>\n",
    "storeOutMessages": true,
    "passthru": false,
    "resendOnRefresh": true,
