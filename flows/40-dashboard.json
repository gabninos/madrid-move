  {
    "id": "a9c502e68d9ef9cb",
    "type": "function",
    "z": "cf931b46039477f7",
    "name": "Formular-Vorgaben",
    "func": "// Beim Start: Vorgaben ins Formular schreiben (Abfahrt 08:30, Mo–Fr, vorsichtige Grenzen)\nconst D = global.get('cfg').reco.defaultSettings;\nconst f = flow.get('form') || {};\nf.time = f.time || '08:30';\nf.days = (f.days && f.days.length) ? f.days : [1, 2, 3, 4, 5];\nf.rain = f.rain || D.rain;\nf.windMax = f.windMax || D.windMax;\nf.tempMin = isFinite(f.tempMin) ? f.tempMin : D.tempMin;\nf.tempMax = isFinite(f.tempMax) ? f.tempMax : D.tempMax;\nflow.set('form', f);\nreturn [{ payload: f.time }, { payload: f.days }, { payload: f.rain }, { payload: f.windMax },\n    { payload: f.tempMin }, { payload: f.tempMax }];\n",
    "outputs": 6,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
