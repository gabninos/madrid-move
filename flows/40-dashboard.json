  {
    "id": "c0bb66e34aebe6ae",
    "type": "function",
    "name": "Wettertext",
    "func": "// .../live/weather -> Textzeile: aktuelles Wetter + Regen in der Vorhersage (nächste 2 h)\nconst w = msg.payload;\nif (typeof w !== 'object' || w == null) return null;\nconst hm = ms => new Date(ms).toLocaleTimeString('de-DE', { timeZone: 'Europe/Madrid', hour: '2-digit', minute: '2-digit' });\nconst rain = (w.forecast || []).filter(f => f.t <= Date.now() + 2 * 3600000 && f.precip >= 0.1);\nconst fc = !(w.forecast || []).length ? '' : rain.length ? ' · Regen erwartet ab ' + hm(rain[0].t) : ' · nächste 2 h trocken';\nreturn { payload: w.temp + ' °C · ' + w.precip + ' mm · Wind ' + w.wind + ' km/h' + fc +\n    ' · Stand ' + hm(w.ts) + (w.demo ? ' (Simulation)' : '') };\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
