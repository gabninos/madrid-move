  {
    "id": "969ebbd97eb65c0e",
    "type": "comment",
    "z": "cf931b46039477f7",
    "name": "Seite \"Routen & Einstellungen\": Start-/Zielstation, Abfahrt, persönliche Grenzen",
    "info": "Jedes Feld sendet mit eigenem msg.topic an **Formular**. Beim Anlegen werden Start- und Zieladresse nacheinander per Nominatim (OpenStreetMap) in Koordinaten umgewandelt (max. 1 Anfrage pro Sekunde), dann wird die Route retained veröffentlicht.",
    "x": 260,
    "y": 240,
    "wires": []
  },
  {
    "id": "5863149a8965c7e0",
    "type": "function",
    "name": "Formular",
    "func": "// Formulare \"Neue Route\" und \"Meine Einstellungen\". Jedes Feld sendet mit eigenem msg.topic.\n// Ausgang 1: MQTT (Route, Einstellungen, Löschen) | 2: Status Route | 3: Status Einstellungen\nconst cfg = global.get('cfg');\nconst P = cfg.prefix;\nconst D = cfg.reco.defaultSettings;\nconst f = flow.get('form') || {};\nconst slug = s => String(s || '').toLowerCase().normalize('NFD')\n    .replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-')\n    .replace(/^-|-$/g, '').slice(0, 30);\nconst save = () => flow.set('form', f);\nconst stationName = id => ((flow.get('stations') || []).find(s => s.id === id) || {}).name;\n\nswitch (msg.topic) {\n    case 'user': f.user = msg.payload; break;\n    case 'name': f.name = msg.payload; break;\n    case 'from': f.from = msg.payload; break;\n    case 'to': f.to = msg.payload; break;\n    case 'time': f.time = msg.payload; break;\n    case 'days': f.days = (Array.isArray(msg.payload) ? msg.payload : [msg.payload]).map(Number).filter(Boolean); break;\n    case 'rain': f.rain = msg.payload; break;\n    case 'windMax': f.windMax = Number(msg.payload); break;\n    case 'tempMin': f.tempMin = Number(msg.payload); break;\n    case 'tempMax': f.tempMax = Number(msg.payload); break;\n    case 'delSel': f.del = msg.payload; break;\n    case 'create': {\n        const u = slug(f.user), r = slug(f.name);\n        if (!u || !r) return [null, { payload: '⚠ Bitte oben deinen Namen und einen Routennamen eingeben.' }, null];\n        const a = stationName(f.from), b = stationName(f.to);\n        if (!a || !b) return [null, { payload: '⚠ Bitte Start- und Zielstation auswählen.' }, null];\n        if (f.from === f.to) return [null, { payload: '⚠ Start und Ziel sind dieselbe Station.' }, null];\n        if (!/^\\d{1,2}:\\d{2}$/.test(String(f.time || ''))) return [null, { payload: '⚠ Bitte eine Abfahrtszeit eingeben (z. B. 08:30).' }, null];\n        if (!f.days || !f.days.length) return [null, { payload: '⚠ Bitte mindestens einen Wochentag wählen.' }, null];\n        const mine = Object.keys(flow.get('routeKeys') || {}).filter(k => k.split('/')[0] === u && k !== u + '/' + r);\n        if (mine.length >= cfg.reco.maxRoutesPerUser) return [null, { payload: '⚠ Höchstens ' + cfg.reco.maxRoutesPerUser + ' Routen pro Nutzer.' }, null];\n        save();\n        const time = String(f.time).padStart(5, '0');\n        const route = { name: f.name, from: { id: f.from, label: a }, to: { id: f.to, label: b },\n            departure: { time: time, days: f.days.slice().sort() }, createdAt: new Date().toISOString() };\n        return [{ topic: P + '/routes/' + u + '/' + r, payload: route, qos: 1, retain: true },\n            { payload: '✔ Route ' + u + '/' + r + ' gespeichert: ' + a + ' → ' + b + ', ' + time + ' Uhr.' }, null];\n    }\n    case 'saveSettings': {\n        const u = slug(f.user);\n        if (!u) return [null, null, { payload: '⚠ Bitte oben deinen Namen eingeben.' }];\n        const s = {\n            rain: f.rain || D.rain,\n            windMax: isFinite(f.windMax) && f.windMax > 0 ? f.windMax : D.windMax,\n            tempMin: isFinite(f.tempMin) ? f.tempMin : D.tempMin,\n            tempMax: isFinite(f.tempMax) ? f.tempMax : D.tempMax\n        };\n        if (s.tempMin >= s.tempMax) return [null, null, { payload: '⚠ Mindesttemperatur muss unter der Höchsttemperatur liegen.' }];\n        save();\n        const regen = { kein: 'kein Regen', leicht: 'leichter Regen ok', egal: 'Regen egal' }[s.rain];\n        return [{ topic: P + '/users/' + u + '/settings', payload: s, qos: 1, retain: true }, null,\n            { payload: '✔ Gespeichert für ' + u + ': ' + regen + ', Wind bis ' + s.windMax + ' km/h, ' + s.tempMin + ' bis ' + s.tempMax + ' °C.' }];\n    }\n    case 'delete': {\n        if (!f.del) return [null, { payload: '⚠ Bitte eine Route zum Löschen wählen.' }, null];\n        const key = f.del;\n        f.del = null;\n        save();\n        // Leere Retained-Nachricht = gespeicherte Route auf dem Broker löschen\n        return [{ topic: P + '/routes/' + key, payload: '', qos: 1, retain: true },\n            { payload: '🗑 Route ' + key + ' gelöscht.' }, null];\n    }\n}\nsave();\nreturn null;\n",
