    "id": "fc9388be0aaf8c1f",
    "type": "function",
    "name": "Statustabelle",
    "func": "// .../system/+ -> Tabelle \"Datenquellen\"\nconst cfg = global.get('cfg');\nlet rows = context.get('rows');\nif (!rows || rows.__prefix !== cfg.prefix) rows = { __prefix: cfg.prefix };\nconst name = msg.topic.split('/').pop();\nrows[name] = {\n    'Quelle': name,\n    'Status': String(msg.payload),\n    'Seit': new Date().toLocaleTimeString('de-DE', { timeZone: 'Europe/Madrid' })\n};\ncontext.set('rows', rows);\nreturn { payload: Object.keys(rows).filter(k => k !== '__prefix').map(k => rows[k]) };\n",
