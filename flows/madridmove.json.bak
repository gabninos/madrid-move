  {
    "id": "e9aecbc526794005",
    "type": "function",
    "name": "Profile merken",
    "func": "// Merkt sich die Profile, damit der Demo-Schalter die Startstationen kennt\nconst profiles = flow.get('demoProfiles') || {};\nconst key = msg.topic.split('/').slice(-2).join('/');\nif (typeof msg.payload === 'object' && msg.payload) profiles[key] = msg.payload;\nelse delete profiles[key];\nflow.set('demoProfiles', profiles);\nreturn null;\n",
    "outputs": 1,
