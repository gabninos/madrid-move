  {
    "id": "1a56c5921bfbfcb3",
    "type": "function",
    "name": "Wetter-URL",
    "func": "// Open-Meteo: aktuelles Wetter am Wetterpunkt (alle 10 min oder auf Kommando)\nconst cfg = global.get('cfg');\nconst p = cfg.weatherPoint;\nconst url = cfg.apis.meteo +\n    '?latitude=' + p.lat + '&longitude=' + p.lon +\n    '&current=temperature_2m,precipitation,wind_speed_10m,weather_code' +\n    '&timezone=Europe%2FMadrid';\nreturn { url: url };\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "7f501a4c6ea84ee9"
