  {
    "id": "a83333ddf90a5dfb",
    "type": "function",
    "name": "Tabelle bauen",
    "func": "// .../reco/+/+ -> Tabelle aller Empfehlungen (eine Zeile pro Route)\nconst rows = context.get('rows') || {};\nconst key = msg.topic.split('/').slice(-2).join('/');\nconst empty = msg.payload === '' || msg.payload == null ||\n    (Buffer.isBuffer(msg.payload) && msg.payload.length === 0);\nif (empty || typeof msg.payload !== 'object') {\n    delete rows[key];\n} else {\n    const r = msg.payload;\n    const o = m => r.options.find(x => x.mode === m);\n    const fmt = x => !x ? '–' : (x.ok ? x.min + ' min' : 'nicht möglich');\n    const best = o(r.best);\n    rows[key] = {\n        'Nutzer': r.user,\n        'Route': r.name,\n        'Von → Nach': r.from + ' → ' + r.to,\n        'Empfehlung': r.bestLabel + ' (' + r.bestMin + ' min)',\n        'BiciMAD': fmt(o('bike')),\n        'ÖPNV*': fmt(o('transit')),\n        'Zu Fuß': fmt(o('walk')),\n        'Begründung': (best ? best.why : []).concat(r.notes || []).join(', '),\n        'Stand': new Date(r.updated).toLocaleTimeString('de-DE', { timeZone: 'Europe/Madrid' })\n    };\n}\ncontext.set('rows', rows);\nmsg.payload = Object.values(rows).sort((a, b) =>\n    (a['Nutzer'] + a['Route']).localeCompare(b['Nutzer'] + b['Route']));\nreturn msg;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "3ab4324b059bad48"
      ]
    ],
