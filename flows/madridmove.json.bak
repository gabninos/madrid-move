  {
    "id": "cf81e327680124eb",
    "type": "function",
    "name": "Routenliste",
    "func": "// .../routes/+/+ -> Liste aller Routen (für \"Route löschen\" und die Obergrenze)\nconst routes = flow.get('routeKeys') || {};\nconst key = msg.topic.split('/').slice(-2).join('/');\nconst empty = msg.payload === '' || msg.payload == null ||\n    (Buffer.isBuffer(msg.payload) && msg.payload.length === 0);\nif (empty) delete routes[key];\nelse if (typeof msg.payload === 'object') routes[key] = msg.payload.name || key;\nflow.set('routeKeys', routes);\nconst options = Object.keys(routes).sort().map(k => ({ label: k + ' – ' + routes[k], value: k }));\nreturn { ui_update: { options: options.length ? options : [{ label: '(keine Routen)', value: '' }] } };\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
