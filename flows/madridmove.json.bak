  {
    "id": "2b921a8ea30d5121",
    "type": "comment",
    "z": "41cdb26069d4ff9b",
    "name": "BiciMAD: Status (jede Minute, nur Änderungen)",
    "info": "Ein Topic pro Station: `.../live/bicimad/<id>`, QoS 0, retained. Gesendet wird nur bei Änderung, spätestens alle 10 min.\n\nDas Kommando `.../cmd/bicimad/refresh` (Demo-Schalter) erzwingt ein komplettes Neusenden.",
    "x": 250,
    "y": 140,
    "wires": []
  },
  {
    "id": "14cc16d89643adbe",
    "type": "inject",
    "name": "jede Minute",
    "props": [
      {
        "p": "topic",
        "vt": "str"
      }
    ],
    "repeat": "60",
    "crontab": "",
    "once": true,
    "onceDelay": 10,
    "topic": "",
    "wires": [
      [
        "abb79385c33df652"
      ]
    ],
    "x": 140,
    "y": 180,
    "z": "41cdb26069d4ff9b"
  },
  {
    "id": "abb79385c33df652",
    "type": "function",
    "name": "Status-URL",
    "func": "// Startet den Abruf von station_status (jede Minute).\n// Ein Kommando auf .../cmd/bicimad/refresh leert den Cache,\n// dann werden beim nächsten Abruf ALLE Stationen neu veröffentlicht.\nif (typeof msg.topic === 'string' && msg.topic.endsWith('/cmd/bicimad/refresh')) {\n    flow.set('lastSent', {});\n    node.status({ fill: 'blue', shape: 'dot', text: 'Neu senden angefordert' });\n}\nconst feeds = flow.get('feeds');\nif (!feeds) {\n    node.status({ fill: 'yellow', shape: 'ring', text: 'warte auf Feed-URLs' });\n    return null;\n}\nreturn { url: feeds.station_status };\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "d33b929ce575f33c"
      ]
    ],
    "x": 330,
    "y": 180,
    "z": "41cdb26069d4ff9b"
  },
  {
    "id": "d33b929ce575f33c",
    "type": "http request",
    "name": "station_status",
    "method": "GET",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "",
    "tls": "",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
    "senderr": false,
    "headers": [],
    "wires": [
      [
        "dfd0122473f613a3"
      ]
    ],
    "x": 520,
    "y": 180,
    "z": "41cdb26069d4ff9b"
  },
  {
    "id": "dfd0122473f613a3",
    "type": "function",
    "name": "Status publizieren",
    "func": "// station_status -> ein Topic pro Station: .../live/bicimad/<station-id>\n// \"Report by Exception\": nur Stationen, deren Werte sich geändert haben,\n// werden gesendet, spätestens aber alle 10 min (damit Empfänger frische\n// Zeitstempel sehen und veraltete Daten erkennen können).\nconst cfg = global.get('cfg');\nif (msg.statusCode !== 200 || typeof msg.payload !== 'object') {\n    node.status({ fill: 'red', shape: 'ring', text: 'HTTP ' + msg.statusCode });\n    return null;\n}\nconst REFRESH_MS = 10 * 60 * 1000;\nconst list = (msg.payload.data && msg.payload.data.stations) || [];\nconst last = flow.get('lastSent') || {};\nconst now = Date.now();\nconst out = [];\nfor (const s of list) {\n    const id = String(s.station_id);\n    const v = {\n        bikes: s.num_bikes_available,\n        docks: s.num_docks_available,\n        renting: !(s.is_renting === 0 || s.is_renting === false),\n        returning: !(s.is_returning === 0 || s.is_returning === false)\n    };\n    const key = [v.bikes, v.docks, v.renting, v.returning].join('/');\n    const prev = last[id];\n    if (prev && prev.key === key && now - prev.t < REFRESH_MS) continue;\n    last[id] = { key: key, t: now };\n    v.ts = now;\n    out.push({ topic: cfg.prefix + '/live/bicimad/' + id, payload: v, qos: 0, retain: true });\n}\nflow.set('lastSent', last);\nnode.status({ fill: 'green', shape: 'dot',\n    text: out.length + '/' + list.length + ' gesendet, ' + new Date().toLocaleTimeString('de-DE') });\nreturn [out];\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "87de5ff188623b7c"
      ]
    ],
    "x": 710,
    "y": 180,
    "z": "41cdb26069d4ff9b"
  },
