  {
    "id": "c0bb66e34aebe6ae",
    "type": "function",
    "name": "Wettertext",
    "func": "// .../live/weather -> Textzeile\nconst w = msg.payload;\nif (typeof w !== 'object' || w == null) return null;\nconst t = new Date(w.ts).toLocaleTimeString('de-DE', { timeZone: 'Europe/Madrid' });\nreturn { payload: w.temp + ' °C · ' + w.precip + ' mm Regen · ' + w.wind + ' km/h Wind · ' + t + (w.demo ? ' (DEMO)' : '') };\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
