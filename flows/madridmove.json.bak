  {
    "id": "e9a5bb38b5fe76e2",
    "type": "function",
    "name": "Demo",
    "func": "// Demo-Schalter: löst Situationen auf Knopfdruck aus (Nachrichten NICHT retained)\nconst cfg = global.get('cfg');\nconst P = cfg.prefix;\nconst now = Date.now();\nswitch (msg.topic) {\n    case 'rain':\n        return [[{ topic: P + '/live/weather', qos: 0, retain: false,\n            payload: { temp: 11, precip: 3.0, wind: 12, code: 65, ts: now, demo: true, source: 'demo' } }]];\n    case 'empty': {\n        const profiles = Object.values(flow.get('demoProfiles') || {});\n        const ids = {};\n        profiles.forEach(p => { ids[p.from.id] = p.from.capacity || 20; });\n        return [Object.keys(ids).map(id => ({\n            topic: P + '/live/bicimad/' + id, qos: 0, retain: false,\n            payload: { bikes: 0, docks: ids[id], renting: true, returning: true, ts: now, demo: true }\n        }))];\n    }\n    case 'reset':\n        // Collectors senden beim nächsten Abruf wieder echte Werte\n        return [[\n            { topic: P + '/cmd/bicimad/refresh', payload: 'refresh', qos: 1, retain: false },\n            { topic: P + '/cmd/weather/refresh', payload: 'refresh', qos: 1, retain: false }\n        ]];\n    case 'demoroutes': {\n        // Drei Beispielrouten für den Nutzer \"demo\" (Koordinaten -> nächste Station)\n        const mk = (id, name, a, b) => ({\n            topic: P + '/routes/demo/' + id, qos: 1, retain: true,\n            payload: { name: name, from: a, to: b, createdAt: new Date().toISOString() }\n        });\n        return [[\n            mk('sol-moncloa', 'Sol → Moncloa', { lat: 40.4169, lon: -3.7035 }, { lat: 40.4352, lon: -3.7190 }),\n            mk('atocha-retiro', 'Atocha → Retiro', { lat: 40.4066, lon: -3.6892 }, { lat: 40.4199, lon: -3.6887 }),\n            mk('moncloa-uni', 'Moncloa → Ciudad Universitaria', { lat: 40.4352, lon: -3.7190 }, { lat: 40.4437, lon: -3.7276 })\n        ]];\n    }\n}\nreturn null;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "48c791825beaedd7"
      ]
    ],
    "x": 620,
    "y": 900,
    "z": "cf931b46039477f7"
  },
