  {
    "id": "fc9388be0aaf8c1f",
    "type": "function",
    "name": "Statustabelle",
    "func": "// .../system/+ -> Tabelle \"Datenquellen\"\nconst rows = context.get('rows') || {};\nconst name = msg.topic.split('/').pop();\nrows[name] = {\n    'Quelle': name,\n    'Status': String(msg.payload),\n    'Seit': new Date().toLocaleTimeString('de-DE', { timeZone: 'Europe/Madrid' })\n};\ncontext.set('rows', rows);\nreturn { payload: Object.values(rows) };\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
