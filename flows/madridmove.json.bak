  },
  {
    "id": "7e5443edbd3ce42f",
    "type": "function",
    "name": "GBFS-URL",
    "func": "// Startet den Abruf der GBFS-Einstiegsdatei\nconst cfg = global.get('cfg');\nreturn { url: cfg.apis.gbfs };\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "d963b339f11b497f"
      ]
    ],
    "x": 330,
    "y": 80,
    "z": "41cdb26069d4ff9b"
  },
  {
    "id": "d963b339f11b497f",
    "type": "http request",
    "name": "GBFS-Einstieg",
    "method": "GET",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "",
    "tls": "",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
    "senderr": false,
    "headers": [],
    "wires": [
      [
        "4af29c5874c0ba69"
      ]
    ],
    "x": 520,
    "y": 80,
    "z": "41cdb26069d4ff9b"
  },
  {
    "id": "4af29c5874c0ba69",
    "type": "function",
    "name": "Feeds finden",
    "func": "// Liest aus der GBFS-Einstiegsdatei die URLs der benötigten Feeds\nif (msg.statusCode !== 200 || typeof msg.payload !== 'object') {\n    node.status({ fill: 'red', shape: 'ring', text: 'GBFS: HTTP ' + msg.statusCode });\n    node.warn({ hinweis: 'GBFS-Einstiegsdatei nicht lesbar', statusCode: msg.statusCode, payload: msg.payload });\n    return null;\n}\nconst data = msg.payload.data || {};\n// GBFS gruppiert Feeds nach Sprache: data.es.feeds, data.en.feeds, ...\nconst lang = data.es ? 'es' : (data.en ? 'en' : Object.keys(data)[0]);\nconst feeds = {};\nfor (const f of (data[lang] && data[lang].feeds) || []) feeds[f.name] = f.url;\nif (!feeds.station_information || !feeds.station_status) {\n    node.status({ fill: 'red', shape: 'ring', text: 'Feeds fehlen' });\n    node.warn({ hinweis: 'station_information/station_status nicht gefunden', gefunden: Object.keys(feeds) });\n    return null;\n}\nflow.set('feeds', feeds);\nnode.status({ fill: 'green', shape: 'dot', text: 'Feeds gefunden (' + lang + ')' });\nreturn { url: feeds.station_information };\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "a65961ef574af49d"
      ]
    ],
    "x": 710,
    "y": 80,
    "z": "41cdb26069d4ff9b"
  },
  {
    "id": "a65961ef574af49d",
    "type": "http request",
    "name": "station_information",
    "method": "GET",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "",
    "tls": "",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
    "senderr": false,
    "headers": [],
    "wires": [
      [
        "bae57bbda69e49f1"
      ]
    ],
    "x": 900,
    "y": 80,
    "z": "41cdb26069d4ff9b"
  },
  {
    "id": "bae57bbda69e49f1",
    "type": "function",
    "name": "Stationsliste",
    "func": "// station_information: Name, Lage, Kapazität aller Stationen.\n// Wird als EINE Retained-Nachricht veröffentlicht (Stationsliste fürs Formular\n// und für den Profil-Dienst). Ändert sich selten -> Abruf alle 24 h.\nconst cfg = global.get('cfg');\nif (msg.statusCode !== 200 || typeof msg.payload !== 'object') {\n    node.status({ fill: 'red', shape: 'ring', text: 'HTTP ' + msg.statusCode });\n    return null;\n}\nconst list = (msg.payload.data && msg.payload.data.stations) || [];\nconst out = list.map(s => ({\n    id: String(s.station_id),\n    name: s.name,\n    lat: s.lat,\n    lon: s.lon,\n    capacity: s.capacity\n}));\nout.sort((a, b) => a.name.localeCompare(b.name, 'es'));\nnode.status({ fill: 'green', shape: 'dot', text: out.length + ' Stationen' });\nreturn { topic: cfg.prefix + '/static/stations', payload: out, qos: 1, retain: true };\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "56a71a94373b69ec"
      ]
    ],
    "x": 1090,
    "y": 80,
    "z": "41cdb26069d4ff9b"
  },
