  {
    "id": "e69465b5990fcce1",
    "type": "comment",
    "z": "834af59d0d1345e8",
    "name": "Konfiguration: Function öffnen → Reiter \"Beim Start\"",
    "info": "Hier stehen alle externen APIs und Parameter.\n\nWerte per Umgebungsvariable überschreiben: `ORS_API_KEY`, `GBFS_URL`, `METEO_URL`, `ORS_URL`.\n\nDer Inject zeigt die aktive Konfiguration im Debug-Fenster.",
    "x": 220,
    "y": 40,
    "wires": []
  },
  {
    "id": "d6e9d04da12e7685",
    "type": "inject",
    "name": "Konfiguration anzeigen",
    "props": [
      {
        "p": "topic",
        "vt": "str"
      }
    ],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 1,
    "topic": "",
    "wires": [
      [
        "91be756d312bee56"
      ]
    ],
    "x": 140,
    "y": 100,
    "z": "834af59d0d1345e8"
  },
  {
    "id": "91be756d312bee56",
    "type": "function",
    "name": "Konfiguration",
    "func": "// Zeigt die aktive Konfiguration im Debug-Fenster (Schlüssel maskiert)\nconst cfg = JSON.parse(JSON.stringify(global.get('cfg')));\nif (cfg.apis.orsKey) cfg.apis.orsKey = cfg.apis.orsKey.slice(0, 4) + '…';\nmsg.payload = cfg;\nreturn msg;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "// ============================================================\n//  MadridMove – zentrale Konfiguration\n//  Alle externen APIs und alle Schwellwerte stehen NUR hier.\n//  Jeder Wert kann per Umgebungsvariable überschrieben werden,\n//  z. B. ORS_API_KEY=abc node-red   bzw.   docker run -e ORS_API_KEY=abc ...\n// ============================================================\nconst cfg = {\n    // Topic-Präfix: wird von configure.py gesetzt, nicht von Hand ändern\n    prefix: 'upm-dsiot-g12-tobias/move',\n\n    apis: {\n        // BiciMAD (GBFS-Einstiegsdatei; die Feed-URLs werden daraus gelesen)\n        gbfs: env.get('GBFS_URL') || 'https://madrid.publicbikesystem.net/customer/gbfs/v2/gbfs.json',\n        // Open-Meteo (Wetter, ohne Schlüssel)\n        meteo: env.get('METEO_URL') || 'https://api.open-meteo.com/v1/forecast',\n        // openrouteservice (Routing mit Höhe und Wegart, kostenloser Schlüssel)\n        ors: env.get('ORS_URL') || 'https://api.openrouteservice.org',\n        orsKey: env.get('ORS_API_KEY') || ''\n    },\n\n    // Wetterpunkt: Puerta del Sol\n    weatherPoint: { lat: 40.4168, lon: -3.7038 },\n\n    // Parameter der Empfehlungslogik (Minuten, km/h, mm, °C)\n    reco: {\n        bikeMinBikes: 1,        // mind. so viele Räder am Start\n        bikeMinDocks: 1,        // mind. so viele freie Plätze am Ziel\n        dockMin: 2,             // Ausleihen + Abstellen\n        minPerHmUp: 0.15,       // Aufschlag pro Höhenmeter bergauf (9 s)\n        cyclewayBonusMax: 3,    // Bonus bei 100 % Radweg\n        rainLight: 0.1,         // mm Niederschlag (letzte 15 min) = leichter Regen\n        rainHeavy: 1.0,         // mm = starker Regen\n        rainPenaltyBike: 8,\n        rainPenaltyWalk: 5,\n        windStrong: 30,         // km/h\n        windPenaltyBike: 3,\n        coldBelow: 3,           // °C\n        hotAbove: 35,           // °C\n        tempPenalty: 3,\n        bikeSpeedKmh: 14,       // nur Schätzmodus (ohne ORS)\n        walkSpeedKmh: 4.8,      // nur Schätzmodus\n        detourFactor: 1.3,      // Luftlinie -> Straßenweg (Schätzmodus)\n        transitSpeedKmh: 18,    // ÖPNV-Schätzung: mittlere Reisegeschwindigkeit\n        transitAccessMin: 8,    // Fußwege zur und von der Haltestelle\n        transitWaitMin: 4,      // mittlere Wartezeit\n        staleMin: 15,           // BiciMAD-Daten älter als das = veraltet\n        weatherStaleMin: 30,    // Wetterdaten älter als das = veraltet\n        maxRoutesPerUser: 3\n    }\n};\nglobal.set('cfg', cfg);\nnode.status({\n    fill: cfg.apis.orsKey ? 'green' : 'yellow', shape: 'dot',\n    text: cfg.apis.orsKey ? 'ORS-Schlüssel gesetzt' : 'kein ORS-Schlüssel: Schätzmodus'\n});\n",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "c42f53684116e1d0"
      ]
    ],
    "x": 330,
    "y": 100,
    "z": "834af59d0d1345e8"
  },
  {
    "id": "c42f53684116e1d0",
    "type": "debug",
    "name": "aktive Konfiguration",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "false",
