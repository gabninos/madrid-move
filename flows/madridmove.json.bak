  {
    "id": "95e2a023da7345ca",
    "type": "comment",
    "z": "c74bf7aebad4c5d0",
    "name": "Eingänge (Wildcards) → Empfehlung",
    "info": "Die Gewichte stehen in der Konfiguration (`cfg.reco`).",
    "x": 230,
    "y": 40,
    "wires": []
  },
  {
    "id": "227226d5f179f0e4",
    "type": "function",
    "name": "Empfehlung berechnen",
    "func": "// ============================================================\n//  Empfehlungsdienst\n//  Eingänge (alle per Wildcard abonniert):\n//    .../profiles/+/+       Streckenprofile (retained)\n//    .../live/bicimad/+     Räder/Plätze je Station\n//    .../live/weather       aktuelles Wetter\n//    .../system/+           Status der Collectors (Birth / Close / Last Will)\n//    Takt alle 60 s         prüft, ob Daten veraltet sind\n//  Ausgänge (ein Ausgang, mehrere Nachrichten):\n//    .../reco/<nutzer>/<route>   Empfehlung, QoS 1, retained\n//    .../alerts/<nutzer>         Wechsel der Empfehlung, QoS 1, nicht retained\n// ============================================================\nconst cfg = global.get('cfg');\nconst R = cfg.reco, P = cfg.prefix;\nconst st = context.get('st') || { profiles: {}, bikes: {}, weather: null, system: {}, last: {} };\nconst t = msg.topic || '';\nconst isEmpty = msg.payload === '' || msg.payload == null ||\n    (Buffer.isBuffer(msg.payload) && msg.payload.length === 0);\nconst allKeys = () => Object.keys(st.profiles);\nlet affected = [];\n\nif (t.indexOf('/profiles/') >= 0) {\n    const key = t.split('/').slice(-2).join('/');\n    if (isEmpty) {\n        delete st.profiles[key];\n        delete st.last[key];\n        context.set('st', st);\n        node.status({ fill: 'grey', shape: 'dot', text: 'Route entfernt: ' + key });\n        return [[{ topic: P + '/reco/' + key, payload: '', qos: 1, retain: true }]];\n    }\n    st.profiles[key] = msg.payload;\n    // retain=false heißt: frisch berechnet (nicht vom Broker nachgeliefert)\n    st.fresh = st.fresh || {};\n    if (!msg.retain) st.fresh[key] = true;\n    affected = [key];\n} else if (t.indexOf('/live/bicimad/') >= 0) {\n    if (typeof msg.payload !== 'object' || isEmpty) return null;\n    const id = t.split('/').pop();\n    st.bikes[id] = msg.payload;\n    affected = allKeys().filter(k => st.profiles[k].from.id === id || st.profiles[k].to.id === id);\n} else if (t.endsWith('/live/weather')) {\n    if (typeof msg.payload !== 'object' || isEmpty) return null;\n    st.weather = msg.payload;\n    affected = allKeys();\n} else if (t.indexOf('/system/') >= 0) {\n    const name = t.split('/').pop();\n    st.system[name] = String(msg.payload);\n    st.sysAt = st.sysAt || {};\n    st.sysAt[name] = Date.now();     // Zeitpunkt der letzten Statusmeldung\n    affected = allKeys();\n} else {\n    affected = allKeys();   // Takt\n}\n\nconst round = x => Math.round(x);\nconst label = { bike: 'BiciMAD', transit: 'ÖPNV', walk: 'Zu Fuß' };\n\nfunction compute(p) {\n    const now = Date.now();\n    const st = context.get('st');\n    const notes = [];\n    // Ein Collector gilt als lebendig, wenn er \"online\" meldet ODER nach seiner\n    // letzten Statusmeldung noch frische Daten geschickt hat. Das fängt den Fall ab,\n    // dass der Broker eine alte Last-Will-Nachricht erst NACH \"online\" nachliefert.\n    const sysAt = st.sysAt || {};\n    const alive = (name, ts) => (st.system[name] || '').indexOf('online') === 0 ||\n        (ts != null && ts > (sysAt[name] || 0));\n    // ---------- Wetter ----------\n    const w = st.weather;\n    const sysW = st.system.weather || 'unbekannt';\n    const weatherOk = w && (now - w.ts) < R.weatherStaleMin * 60000 &&\n        (w.demo || alive('weather', w.ts));\n    let rainBike = 0, rainWalk = 0, windBike = 0, tempPen = 0, weatherWhy = null;\n    if (weatherOk) {\n        if (w.precip >= R.rainHeavy) { rainBike = 2 * R.rainPenaltyBike; rainWalk = 2 * R.rainPenaltyWalk; weatherWhy = 'starker Regen'; }\n        else if (w.precip >= R.rainLight) { rainBike = R.rainPenaltyBike; rainWalk = R.rainPenaltyWalk; weatherWhy = 'Regen'; }\n        if (w.wind >= R.windStrong) windBike = R.windPenaltyBike;\n        if (w.temp < R.coldBelow || w.temp > R.hotAbove) tempPen = R.tempPenalty;\n    } else {\n        notes.push('ohne Wetterdaten (' + sysW + ')');\n    }\n\n    // ---------- Fahrrad ----------\n    const bike = { mode: 'bike', label: label.bike, min: p.bike.min + R.dockMin, ok: true, why: [] };\n    const sysB = st.system.bicimad || 'unbekannt';\n    const sFrom = st.bikes[p.from.id], sTo = st.bikes[p.to.id];\n    const fresh = s => s && typeof s === 'object' && (now - s.ts) < R.staleMin * 60000;\n    if (!alive('bicimad', sFrom && sFrom.ts)) {\n        bike.ok = false; bike.why.push('BiciMAD-Daten nicht verfügbar (' + sysB + ')');\n    } else if (!fresh(sFrom) || !fresh(sTo)) {\n        bike.ok = false; bike.why.push('Stationsdaten fehlen oder sind veraltet');\n    } else {\n        if (sFrom.bikes < R.bikeMinBikes || !sFrom.renting) { bike.ok = false; bike.why.push('keine Räder an ' + p.from.name); }\n        else bike.why.push(sFrom.bikes + ' Räder am Start');\n        if (sTo.docks < R.bikeMinDocks || !sTo.returning) { bike.ok = false; bike.why.push('kein freier Platz an ' + p.to.name); }\n        else bike.why.push(sTo.docks + ' freie Plätze am Ziel');\n    }\n    if (p.bike.ascent != null && p.bike.ascent > 0) {\n        const add = p.bike.ascent * R.minPerHmUp;\n        bike.min += add;\n        bike.why.push(round(p.bike.ascent) + ' Hm bergauf');\n    }\n    if (p.bike.cyclewayPct != null) {\n        bike.min -= R.cyclewayBonusMax * p.bike.cyclewayPct / 100;\n        bike.why.push(p.bike.cyclewayPct + ' % Radweg');\n    }\n    if (rainBike) { bike.min += rainBike; bike.why.push(weatherWhy); }\n    if (windBike) { bike.min += windBike; bike.why.push('starker Wind'); }\n    if (tempPen) { bike.min += tempPen; bike.why.push('Temperatur ' + round(w.temp) + ' °C'); }\n\n    // ---------- Zu Fuß ----------\n    const walk = { mode: 'walk', label: label.walk, min: p.walk.min + rainWalk + tempPen, ok: true, why: [p.walk.km + ' km'] };\n    if (rainWalk) walk.why.push(weatherWhy);\n\n    // ---------- ÖPNV (Schätzung) ----------\n    const transit = { mode: 'transit', label: label.transit, min: p.transit.min, ok: true,\n        why: ['Schätzung: Fußwege + Warten + Fahrt'] };\n\n    const options = [bike, transit, walk];\n    options.forEach(o => { o.min = round(o.min); });\n    const candidates = options.filter(o => o.ok).sort((a, b) => a.min - b.min);\n    const best = candidates[0];\n    if (p.source && p.source.indexOf('Schätzung') === 0) notes.push('Streckenprofil geschätzt (ohne ORS)');\n    return {\n        user: p.user, route: p.route, name: p.name,\n        from: p.from.name, to: p.to.name,\n        best: best.mode, bestLabel: best.label, bestMin: best.min,\n        summary: best.label + ' · ' + best.min + ' min',\n        options: options, notes: notes,\n        updated: new Date().toISOString()\n    };\n}\n\n// Bündeln (Debounce): Kommen mehrere Updates fast gleichzeitig an\n// (z. B. Station + Wetter), wird nur EINMAL nach 1 s gerechnet und gesendet.\nconst pending = context.get('pending') || {};\naffected.forEach(k => { pending[k] = true; });\ncontext.set('pending', pending);\ncontext.set('st', st);\nif (!context.get('timer')) {\n    context.set('timer', true);\n    setTimeout(flushPending, 1000);\n}\nreturn null;\n\nfunction flushPending() {\n    context.set('timer', false);\n    const keys = Object.keys(context.get('pending') || {});\n    context.set('pending', {});\n    const s = context.get('st');\n    const out = [];\n    for (const key of keys) {\n        const p = s.profiles[key];\n        if (!p) continue;\n        const reco = compute(p);\n        const sig = JSON.stringify([reco.best, reco.options, reco.notes]);\n        const prev = s.last[key];\n        if (prev && prev.sig === sig) continue;          // nichts geändert\n        out.push({ topic: P + '/reco/' + key, payload: reco, qos: 1, retain: true });\n\n        const isNewRoute = !prev && s.fresh && s.fresh[key];\n        if (s.fresh) delete s.fresh[key];\n        if ((prev && prev.best !== reco.best) || isNewRoute) {\n            let text;\n            if (isNewRoute) {\n                text = 'Route \"' + reco.name + '\" ist aktiv: aktuell ' + reco.summary;\n            } else {\n                const old = reco.options.find(o => o.mode === prev.best);\n                const neg = old ? old.why.filter(x => /keine|kein |nicht|veraltet|Regen|Wind|Temperatur/.test(x)) : [];\n                text = 'Route \"' + reco.name + '\": jetzt ' + reco.summary + ' statt ' + label[prev.best] +\n                    (neg.length ? ' (' + neg.join(', ') + ')' : '');\n            }\n            out.push({ topic: P + '/alerts/' + p.user, payload: text, qos: 1, retain: false });\n        }\n        s.last[key] = { sig: sig, best: reco.best };\n    }\n    context.set('st', s);\n    node.status({ fill: 'green', shape: 'dot',\n        text: Object.keys(s.profiles).length + ' Routen, ' + out.length + ' Nachrichten, ' + new Date().toLocaleTimeString('de-DE') });\n    if (out.length) node.send([out]);\n}\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "ce2c74e0f8fc9ce4"
      ]
    ],
