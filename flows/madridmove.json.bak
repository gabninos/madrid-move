  {
    "id": "308b77771730aa5c",
    "type": "function",
    "name": "Wetter publizieren",
    "func": "// Open-Meteo-Antwort -> .../live/weather (retained)\nconst cfg = global.get('cfg');\nconst c = msg.statusCode === 200 && msg.payload && msg.payload.current;\nif (!c) {\n    node.status({ fill: 'red', shape: 'ring', text: 'Wetter: HTTP ' + msg.statusCode });\n    node.warn({ hinweis: 'Unerwartete Open-Meteo-Antwort', payload: msg.payload });\n    return null;\n}\nconst w = {\n    temp: c.temperature_2m,      // °C\n    precip: c.precipitation,     // mm (letzte 15 min)\n    wind: c.wind_speed_10m,      // km/h\n    code: c.weather_code,        // WMO-Wettercode\n    ts: Date.now(),\n    source: 'open-meteo'\n};\nnode.status({ fill: 'green', shape: 'dot', text: w.temp + ' °C, ' + w.precip + ' mm, ' + w.wind + ' km/h' });\nreturn { topic: cfg.prefix + '/live/weather', payload: w, qos: 0, retain: true };\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
