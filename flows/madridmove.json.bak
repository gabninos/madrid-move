  },
  {
    "id": "4cb90465ada52040",
    "type": "mqtt in",
    "name": "Stationsliste",
    "topic": "upm-dsiot-g12-tobias/move/static/stations",
    "qos": "1",
    "datatype": "auto-detect",
    "broker": "371a175cdaa0c57c",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "wires": [
      [
        "33a774fb5ed4ae01"
      ]
    ],
    "x": 140,
    "y": 80,
    "z": "d0758e3c8908c3f2"
  },
  {
    "id": "33a774fb5ed4ae01",
    "type": "function",
    "name": "Stationen merken",
    "func": "// Merkt sich die Stationsliste (.../static/stations, retained).\n// Routen, die vorher eingetroffen sind, werden jetzt nachträglich verarbeitet.\nconst list = Array.isArray(msg.payload) ? msg.payload : [];\nconst map = {};\nfor (const s of list) map[s.id] = s;\nflow.set('stations', map);\nnode.status({ fill: 'green', shape: 'dot', text: list.length + ' Stationen bekannt' });\nconst pending = flow.get('pending') || {};\nflow.set('pending', {});\nreturn [Object.values(pending)];\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "f633caa61b5c5d68"
      ]
    ],
    "x": 330,
    "y": 80,
    "z": "d0758e3c8908c3f2"
  },
  {
    "id": "367f42a1060eac48",
    "type": "mqtt in",
    "name": "vorhandene Profile",
    "topic": "upm-dsiot-g12-tobias/move/profiles/+/+",
    "qos": "1",
    "datatype": "auto-detect",
    "broker": "371a175cdaa0c57c",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "wires": [
      [
        "8dcf85bf20130941"
      ]
    ],
    "x": 140,
    "y": 130,
    "z": "d0758e3c8908c3f2"
  },
  {
    "id": "8dcf85bf20130941",
    "type": "function",
    "name": "Profil-Cache",
    "func": "// Merkt sich, für welche Routen schon ein Profil existiert (retained).\n// So wird nach einem Neustart nicht jede Route erneut bei ORS angefragt.\nconst cache = flow.get('profiles') || {};\nconst key = msg.topic.split('/').slice(-2).join('/');\nconst empty = msg.payload === '' || msg.payload == null ||\n    (Buffer.isBuffer(msg.payload) && msg.payload.length === 0);\nif (empty) delete cache[key];\nelse if (typeof msg.payload === 'object') cache[key] = msg.payload.routeHash;\nflow.set('profiles', cache);\nreturn null;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      []
    ],
    "x": 330,
    "y": 130,
    "z": "d0758e3c8908c3f2"
  },
  {
    "id": "4292bdda0ecfc26b",
    "type": "comment",
    "z": "d0758e3c8908c3f2",
    "name": "Routen → Profil (ORS: Fahrrad + Fußweg)",
    "info": "Ausgang 1: Route gelöscht → Profil löschen\n\nAusgang 2: ORS-Anfragen (gedrosselt auf 1 alle 2 s wegen API-Limit)\n\nAusgang 3: kein ORS-Schlüssel → Schätzung",
    "x": 260,
    "y": 190,
    "wires": []
  },
  {
    "id": "67ee2b9e77727624",
    "type": "mqtt in",
    "name": "Routen",
    "topic": "upm-dsiot-g12-tobias/move/routes/+/+",
    "qos": "1",
    "datatype": "auto-detect",
    "broker": "371a175cdaa0c57c",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "wires": [
      [
        "f633caa61b5c5d68"
      ]
    ],
    "x": 140,
    "y": 260,
    "z": "d0758e3c8908c3f2"
  },
  {
    "id": "f633caa61b5c5d68",
    "type": "function",
    "name": "Routen-Eingang",
    "func": "// Eingang für Routen: .../routes/<nutzer>/<route-id>\n// Payload: {\"name\":\"Zur Uni\",\"from\":{\"id\":\"57\"},\"to\":{\"lat\":40.44,\"lon\":-3.72}}\n//   Start/Ziel entweder als Stations-ID oder als Koordinate (-> nächste Station)\n// Leere Retained-Nachricht = Route gelöscht -> Profil ebenfalls löschen.\n// Ausgang 1: Profil löschen | 2: ORS-Anfrage | 3: Schätzmodus (ohne ORS)\nconst cfg = global.get('cfg');\nconst parts = msg.topic.split('/');\nconst user = parts[parts.length - 2], routeId = parts[parts.length - 1];\nconst key = user + '/' + routeId;\nconst profileTopic = cfg.prefix + '/profiles/' + key;\n\nconst empty = msg.payload === '' || msg.payload == null ||\n    (Buffer.isBuffer(msg.payload) && msg.payload.length === 0);\nif (empty) {\n    node.status({ fill: 'grey', shape: 'dot', text: 'gelöscht: ' + key });\n    return [{ topic: profileTopic, payload: '', qos: 1, retain: true }, null, null];\n}\nconst r = msg.payload;\nif (typeof r !== 'object' || !r.from || !r.to) {\n    node.warn('Ungültige Route auf ' + msg.topic + ': ' + JSON.stringify(r));\n    return null;\n}\nconst stations = flow.get('stations');\nif (!stations || Object.keys(stations).length === 0) {\n    const pending = flow.get('pending') || {};\n    pending[key] = msg;\n    flow.set('pending', pending);\n    node.status({ fill: 'yellow', shape: 'ring', text: 'warte auf Stationsliste' });\n    return null;\n}\n\n// Entfernung in Metern (Näherung, für Stadtentfernungen ausreichend)\nconst dist = (a, b) => {\n    const kx = 111320 * Math.cos(a.lat * Math.PI / 180), ky = 110540;\n    return Math.hypot((a.lon - b.lon) * kx, (a.lat - b.lat) * ky);\n};\nconst resolve = (p) => {\n    if (p.id != null && stations[String(p.id)]) return stations[String(p.id)];\n    if (typeof p.lat === 'number' && typeof p.lon === 'number') {\n        let best = null, bestD = Infinity;\n        for (const s of Object.values(stations)) {\n            const d = dist(p, s);\n            if (d < bestD) { bestD = d; best = s; }\n        }\n        return best;\n    }\n    return null;\n};\nconst from = resolve(r.from), to = resolve(r.to);\nif (!from || !to) {\n    node.warn('Start oder Ziel unbekannt für ' + key + ': ' + JSON.stringify(r));\n    return null;\n}\nif (from.id === to.id) {\n    node.warn('Start und Ziel sind dieselbe Station (' + from.name + ') für ' + key);\n    return null;\n}\n\nconst source = cfg.apis.orsKey ? 'ors' : 'est';\nconst routeHash = from.id + '>' + to.id + '>' + source;\nconst cache = flow.get('profiles') || {};\nif (cache[key] === routeHash) {\n    node.status({ fill: 'green', shape: 'ring', text: 'unverändert: ' + key });\n    return null;\n}\nconst job = {\n    user: user, routeId: routeId, key: key, name: r.name || routeId,\n    from: from, to: to, air: dist(from, to), profileTopic: profileTopic\n};\nnode.status({ fill: 'blue', shape: 'dot', text: 'berechne ' + key });\nif (!cfg.apis.orsKey) return [null, null, { job: job }];\n\nreturn [null, {\n    job: job,\n    url: cfg.apis.ors + '/v2/directions/cycling-regular',\n    headers: {\n        'Authorization': cfg.apis.orsKey,\n        'Content-Type': 'application/json',\n        'Accept': 'application/json'\n    },\n    payload: {\n        coordinates: [[from.lon, from.lat], [to.lon, to.lat]],\n        elevation: true,\n        extra_info: ['waytype', 'steepness'],\n        instructions: false\n    }\n}, null];\n",
    "outputs": 3,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "80272a52bf22f569"
      ],
      [
        "4fc8013d9f907acc"
      ],
      [
        "87c06a4b285214ca"
      ]
    ],
    "x": 330,
    "y": 260,
    "z": "d0758e3c8908c3f2"
  },
  {
    "id": "4fc8013d9f907acc",
    "type": "delay",
    "name": "max. 1 Anfrage / 2 s",
    "pauseType": "rate",
    "timeout": "5",
    "timeoutUnits": "seconds",
    "rate": "1",
    "nbRateUnits": "2",
    "rateUnits": "second",
    "randomFirst": "1",
    "randomLast": "5",
    "randomUnits": "seconds",
    "drop": false,
    "allowrate": false,
    "outputs": 1,
    "wires": [
      [
        "5868173e107d178a"
      ]
    ],
    "x": 520,
    "y": 260,
    "z": "d0758e3c8908c3f2"
  },
  {
    "id": "5868173e107d178a",
    "type": "http request",
    "name": "ORS Fahrrad",
    "method": "POST",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "",
    "tls": "",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
    "senderr": false,
    "headers": [],
    "wires": [
      [
        "1df41b0e99e104a0"
      ]
    ],
    "x": 710,
    "y": 260,
    "z": "d0758e3c8908c3f2"
  },
  {
    "id": "1df41b0e99e104a0",
    "type": "function",
    "name": "Fahrrad auswerten",
    "func": "// Wertet die ORS-Fahrradroute aus: Länge, Dauer, Höhenmeter, Radweganteil.\n// Ausgang 1: weiter zur Fußweg-Anfrage | 2: direkt zum Profil (bei Fehler)\nconst cfg = global.get('cfg');\nconst job = msg.job;\nconst r = msg.statusCode === 200 && msg.payload && msg.payload.routes && msg.payload.routes[0];\nif (!r) {\n    job.orsError = 'ORS Fahrrad: HTTP ' + msg.statusCode + ' ' +\n        JSON.stringify(msg.payload && msg.payload.error || msg.payload).slice(0, 200);\n    node.status({ fill: 'red', shape: 'ring', text: 'ORS-Fehler ' + msg.statusCode });\n    node.warn(job.orsError);\n    return [null, { job: job }];\n}\nconst s = r.summary || {};\n// Wegarten (waytype): 6 = Cycleway (Radweg). amount = Anteil in %\nconst wt = (r.extras && r.extras.waytype && r.extras.waytype.summary) || [];\nconst cycleway = wt.filter(w => w.value === 6).reduce((a, w) => a + w.amount, 0);\n// Steigungsklassen (steepness): 3 = 7–9 %, 4 = 10–15 %, 5 = über 15 %\nconst st = (r.extras && r.extras.steepness && r.extras.steepness.summary) || [];\nconst steep = st.filter(x => x.value >= 3).reduce((a, x) => a + x.amount, 0);\njob.bike = {\n    km: s.distance / 1000,\n    min: s.duration / 60,\n    ascent: s.ascent != null ? s.ascent : (r.ascent != null ? r.ascent : null),\n    descent: s.descent != null ? s.descent : (r.descent != null ? r.descent : null),\n    cyclewayPct: Math.round(cycleway),\n    steepPct: Math.round(steep)\n};\nnode.status({ fill: 'green', shape: 'dot', text: job.key + ': ' + job.bike.km.toFixed(1) + ' km' });\nreturn [{\n    job: job,\n    url: cfg.apis.ors + '/v2/directions/foot-walking',\n    headers: {\n        'Authorization': cfg.apis.orsKey,\n        'Content-Type': 'application/json',\n        'Accept': 'application/json'\n    },\n    payload: {\n        coordinates: [[job.from.lon, job.from.lat], [job.to.lon, job.to.lat]],\n        instructions: false\n    }\n}, null];\n",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "3a1e6fd924641cff"
      ],
      [
        "87c06a4b285214ca"
      ]
    ],
    "x": 900,
    "y": 260,
    "z": "d0758e3c8908c3f2"
  },
  {
    "id": "3a1e6fd924641cff",
    "type": "http request",
    "name": "ORS zu Fuß",
    "method": "POST",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "",
    "tls": "",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
    "senderr": false,
    "headers": [],
    "wires": [
      [
        "87c06a4b285214ca"
      ]
    ],
    "x": 1090,
    "y": 260,
    "z": "d0758e3c8908c3f2"
  },
  {
    "id": "87c06a4b285214ca",
    "type": "function",
    "name": "Profil bauen",
    "func": "// Baut das Streckenprofil und veröffentlicht es retained auf\n// .../profiles/<nutzer>/<route-id>. Fehlende ORS-Daten werden geschätzt.\nconst cfg = global.get('cfg');\nconst R = cfg.reco;\nconst job = msg.job;\n\n// Fußweg-Antwort von ORS (falls vorhanden)\nif (typeof msg.url === 'string' && msg.url.indexOf('foot-walking') >= 0) {\n    const r = msg.statusCode === 200 && msg.payload && msg.payload.routes && msg.payload.routes[0];\n    if (r) job.walk = { km: r.summary.distance / 1000, min: r.summary.duration / 60 };\n    else job.orsError = (job.orsError ? job.orsError + ' | ' : '') + 'ORS Fußweg: HTTP ' + msg.statusCode;\n}\n\nconst r1 = x => x == null ? null : Math.round(x * 10) / 10;\nconst roadKm = job.air / 1000 * R.detourFactor;\nconst bike = job.bike || {\n    km: roadKm, min: roadKm / R.bikeSpeedKmh * 60,\n    ascent: null, descent: null, cyclewayPct: null, steepPct: null\n};\nconst walk = job.walk || { km: roadKm, min: roadKm / R.walkSpeedKmh * 60 };\nconst transitMin = R.transitAccessMin + R.transitWaitMin + bike.km / R.transitSpeedKmh * 60;\nconst source = job.bike ? 'ors' : 'est';\nconst st = s => ({ id: s.id, name: s.name, lat: s.lat, lon: s.lon, capacity: s.capacity });\n\nconst profile = {\n    user: job.user,\n    route: job.routeId,\n    name: job.name,\n    from: st(job.from),\n    to: st(job.to),\n    bike: {\n        km: r1(bike.km), min: r1(bike.min), ascent: r1(bike.ascent), descent: r1(bike.descent),\n        cyclewayPct: bike.cyclewayPct, steepPct: bike.steepPct\n    },\n    walk: { km: r1(walk.km), min: r1(walk.min) },\n    transit: { min: r1(transitMin), estimated: true },\n    source: source === 'ors' ? 'openrouteservice' : 'Schätzung (Luftlinie)',\n    orsError: job.orsError || null,\n    routeHash: job.from.id + '>' + job.to.id + '>' + source,\n    computedAt: new Date().toISOString()\n};\nconst cache = flow.get('profiles') || {};\ncache[job.key] = profile.routeHash;\nflow.set('profiles', cache);\nnode.status({ fill: 'green', shape: 'dot', text: job.key + ' (' + profile.source + ')' });\nreturn { topic: job.profileTopic, payload: profile, qos: 1, retain: true };\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "80272a52bf22f569"
      ]
    ],
    "x": 1280,
    "y": 260,
    "z": "d0758e3c8908c3f2"
  },
