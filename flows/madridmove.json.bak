  {
    "id": "59e76b41f37c0e17",
    "type": "comment",
    "z": "cf931b46039477f7",
    "name": "Seite \"Routen verwalten\"",
    "info": "Jedes Feld sendet mit eigenem msg.topic an die Function **Formular**.",
    "x": 220,
    "y": 230,
    "wires": []
  },
  {
    "id": "5863149a8965c7e0",
    "type": "function",
    "name": "Formular",
    "func": "// Formular \"Route anlegen / löschen\". Jedes Eingabefeld sendet mit eigenem msg.topic.\n// Ausgang 1: MQTT (Route anlegen/löschen) | 2: Statustext im Dashboard\nconst cfg = global.get('cfg');\nconst P = cfg.prefix;\nconst f = flow.get('form') || {};\nconst slug = s => String(s || '').toLowerCase().normalize('NFD')\n    .replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-')\n    .replace(/^-|-$/g, '').slice(0, 30);\n\nswitch (msg.topic) {\n    case 'user': f.user = msg.payload; break;\n    case 'name': f.name = msg.payload; break;\n    case 'from': f.from = msg.payload; break;\n    case 'to': f.to = msg.payload; break;\n    case 'delSel': f.del = msg.payload; break;\n    case 'create': {\n        const u = slug(f.user), r = slug(f.name);\n        if (!u || !r || !f.from || !f.to) return [null, { payload: '⚠ Bitte Name, Routenname, Start und Ziel ausfüllen.' }];\n        if (f.from === f.to) return [null, { payload: '⚠ Start und Ziel sind gleich.' }];\n        const existing = Object.keys(flow.get('routeKeys') || {});\n        const mine = existing.filter(k => k.split('/')[0] === u && k !== u + '/' + r);\n        if (mine.length >= cfg.reco.maxRoutesPerUser) {\n            return [null, { payload: '⚠ Höchstens ' + cfg.reco.maxRoutesPerUser + ' Routen pro Nutzer.' }];\n        }\n        const route = { name: f.name, from: { id: f.from }, to: { id: f.to }, createdAt: new Date().toISOString() };\n        flow.set('form', f);\n        return [\n            { topic: P + '/routes/' + u + '/' + r, payload: route, qos: 1, retain: true },\n            { payload: '✔ Route ' + u + '/' + r + ' angelegt. Aufs Handy: ' + P + '/alerts/' + u }\n        ];\n    }\n    case 'delete': {\n        if (!f.del) return [null, { payload: '⚠ Bitte eine Route zum Löschen wählen.' }];\n        const key = f.del;\n        f.del = null;\n        flow.set('form', f);\n        // Leere Retained-Nachricht = gespeicherte Nachricht auf dem Broker löschen\n        return [\n            { topic: P + '/routes/' + key, payload: '', qos: 1, retain: true },\n            { payload: '🗑 Route ' + key + ' gelöscht.' }\n        ];\n    }\n}\nflow.set('form', f);\nreturn null;\n",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "3f7518d6d1c8eb14"
      ],
      [
        "1ef55eb0d8e799a3"
      ]
    ],
    "x": 620,
    "y": 360,
    "z": "cf931b46039477f7"
  },
